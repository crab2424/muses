# Unity 公式 .gitignore（このフォルダを Unity プロジェクトルートとして使う前提）
# https://github.com/github/gitignore/blob/main/Unity.gitignore

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# Visual Studio / VS Code / Rider が生成するファイル
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Crashlytics generated file
crashlytics-build.properties

# Packages が生成するロックファイルはコミットする（再現性のため除外しない）
!/Packages/packages-lock.json
