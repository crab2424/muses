<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ChartEditorRoot.uss" />

    <!--
        editor-ui-redesign.md §1 の骨格 A〜D。上から順に
        メニューバー / ツールバー / メイン行(タブ + 右パネル) / ステータスバー の4バンド。
        各バンドの「中身」はChartEditorApp.UI.csからコードで流し込む(ツールやメニュー項目は
        列挙型から生成するため)。ここに書くのは器と、器の入れ子関係だけ。
    -->
    <ui:VisualElement name="chart-editor-root" class="root">

        <!-- A: メニューバー(§2.1) -->
        <ui:VisualElement name="menu-bar" class="band menu-bar" />

        <!-- A: ツールバー(§2.2) -->
        <ui:VisualElement name="toolbar" class="band toolbar">
            <ui:VisualElement name="toolbar-file" class="tool-group" />
            <ui:VisualElement class="tool-sep" />
            <ui:VisualElement name="toolbar-edit" class="tool-group" />
            <ui:VisualElement class="tool-sep" />
            <ui:VisualElement name="toolbar-tools" class="tool-group" />
            <ui:VisualElement class="tool-sep" />
            <ui:VisualElement name="toolbar-width" class="tool-group" />
            <ui:VisualElement class="spacer" />
            <ui:Label name="toolbar-status" class="status-text" />
            <ui:Label name="toolbar-dirty" class="dirty-badge" />
        </ui:VisualElement>

        <!-- B/D: メイン行 = タブ付きキャンバス + 右パネル -->
        <ui:VisualElement name="main-row" class="main-row">
            <!-- B: メインキャンバスのタブ(§2.3)。TabView本体はコードで生成して差し込む -->
            <ui:VisualElement name="tabs-host" class="tabs-host" />

            <!--
                D: 右パネル(§2.5)。editor-ui-rework-r11.md §4: 折りたたみ7段から
                「タブ3枚(曲/表示/結果)＋常設インスペクタ」へ再構成。タブヘッダは
                メインキャンバスのタブ(B、上のtabs-host)と同じUSSクラスを再利用する。
            -->
            <ui:VisualElement name="right-panel" class="right-panel">
                <ui:VisualElement name="right-tab-header" class="tab-header" />
                <ui:VisualElement name="right-tab-body" class="right-tab-body">
                    <ui:ScrollView name="right-tab-song" class="right-scroll">
                        <ui:Label text="情報" class="subsection-heading" />
                        <ui:VisualElement name="info-host" />
                        <ui:Label text="音源" class="subsection-heading" />
                        <ui:VisualElement name="audio-host" />
                    </ui:ScrollView>
                    <ui:ScrollView name="right-tab-view" class="right-scroll">
                        <ui:Label text="表示" class="subsection-heading" />
                        <ui:VisualElement name="view-host" />
                        <ui:Label text="プリセット" class="subsection-heading" />
                        <ui:VisualElement name="preset-host" />
                    </ui:ScrollView>
                    <ui:ScrollView name="right-tab-results" class="right-scroll">
                        <ui:Label text="統計" class="subsection-heading" />
                        <ui:Label name="stats-text" class="stats-text" />
                        <ui:Label text="検証結果" class="subsection-heading" />
                        <ui:VisualElement name="validation-host" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="right-inspector" class="right-inspector">
                    <ui:Label text="インスペクタ" class="subsection-heading subsection-heading--pinned" />
                    <ui:ScrollView name="inspector-scroll" class="right-scroll">
                        <ui:VisualElement name="inspector-host" class="inspector-host" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- C: ステータスバー(§2.6)。再生トランスポートをここへ移設した -->
        <ui:VisualElement name="status-bar" class="band status-bar">
            <ui:VisualElement name="status-transport" class="tool-group" />
            <ui:VisualElement class="tool-sep" />
            <ui:VisualElement name="status-snap" class="tool-group" />
            <ui:VisualElement class="tool-sep" />
            <ui:VisualElement name="status-zoom" class="tool-group" />
            <ui:VisualElement class="tool-sep" />
            <ui:VisualElement name="status-scrub" class="status-scrub" />
            <ui:Label name="status-time" class="mono" />
            <ui:VisualElement class="tool-sep" />
            <ui:Label name="status-chartinfo" class="mono" />
            <ui:VisualElement class="tool-sep" />
            <ui:Button name="status-validation" class="link-btn" />
        </ui:VisualElement>

        <!-- モーダル類(ファイル参照・自動保存の復元確認)の置き場 -->
        <ui:VisualElement name="overlay-layer" class="overlay-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
