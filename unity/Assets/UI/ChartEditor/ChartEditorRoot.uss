/*
    editor-ui-redesign.md §2 の見た目。色や寸法はここのカスタムプロパティに集約しておき、
    §2.7 の「エディタ画面倍率」を入れるときは --font-* と --band-h-* を差し替えるだけで
    済むようにしておく(USS変数はCSSのcustom propertyと同じくカスケードする)。
*/
.root {
    flex-grow: 1;

    --bg-canvas: rgb(24, 24, 28);
    --bg-panel: rgb(38, 38, 44);
    --bg-band: rgb(47, 47, 54);
    --bg-control: rgb(58, 58, 66);
    --bg-control-hover: rgb(72, 72, 82);
    --bg-overlay: rgb(30, 30, 36);
    --border: rgb(20, 20, 24);
    --text: rgb(216, 216, 222);
    --text-dim: rgb(143, 143, 154);
    --accent: rgb(74, 158, 255);

    --note-tap: rgb(77, 204, 230);
    --note-extap: rgb(242, 204, 64);
    --note-slide: rgb(102, 230, 153);
    --note-flick: rgb(242, 115, 77);

    --event-bpm: rgb(130, 214, 120);
    --event-meter: rgb(230, 200, 90);
    --event-scroll: rgb(190, 140, 230);

    --band-h: 30px;
    --font-sm: 11px;
    --font-md: 12px;

    flex-direction: column;
    background-color: var(--bg-canvas);
    color: var(--text);
    font-size: var(--font-md);
}

/* ---------- 共通バンド ---------- */

.band {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    background-color: var(--bg-band);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    padding-left: 4px;
    padding-right: 4px;
}

.tool-group {
    flex-direction: row;
    align-items: center;
}

/* 機能グループごとの縦セパレータ(§2.2「区切りが無い」への対処) */
.tool-sep {
    width: 1px;
    height: 16px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: var(--border);
}

.spacer {
    flex-grow: 1;
}

.mono {
    -unity-font-style: bold;
    font-size: var(--font-sm);
    color: var(--text-dim);
    margin-left: 6px;
    margin-right: 6px;
}

/* editor-ui-rework-r4.md §11: 中身の文字数で幅が変わると隣接するstatus-scrubのシークバーが
   動いてしまう。桁数を固定した上で、ラベル自体の幅も固定して確実に動かなくする。 */
#status-time {
    min-width: 70px;
    -unity-text-align: middle-right;
}

#status-chartinfo {
    min-width: 190px;
    -unity-text-align: middle-right;
}

/* ---------- A: メニューバー(§2.1) ---------- */

.menu-bar {
    min-height: 24px;
    background-color: var(--bg-panel);
    padding-left: 2px;
}

.menu-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 3px;
    margin: 0;
    padding-left: 9px;
    padding-right: 9px;
    height: 20px;
    color: var(--text);
    font-size: var(--font-md);
}

.menu-btn:hover {
    background-color: var(--bg-control-hover);
}

/* editor-ui-rework-r5.md §9: 開いている間はホバー切替の対象であることを視覚的に示す。 */
.menu-btn--open {
    background-color: var(--bg-control-hover);
}

/* §9: 自前メニューのポップアップ(GenericDropdownMenuの代替)。 */
.menu-popup {
    background-color: var(--bg-overlay);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    padding: 3px;
    min-width: 200px;
}

.menu-popup-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 4px 10px 4px 10px;
    font-size: var(--font-sm);
    color: var(--text);
}

.menu-popup-item:hover {
    background-color: var(--bg-control-hover);
}

.menu-popup-item:disabled {
    opacity: 0.4;
}

.menu-popup-sep {
    height: 1px;
    margin: 3px 4px;
    background-color: var(--border);
}

/* ---------- A: ツールバー(§2.2) ---------- */

.toolbar {
    min-height: var(--band-h);
}

/* editor-ui-rework-r5.md §6/§7: ツールバーの「幅」欄がstyle.width直書きだったのをUSSへ寄せる */
.tb-field {
    width: 54px;
}

.tb-btn {
    background-color: var(--bg-control);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 3px;
    margin: 0 2px 0 0;
    padding: 0 8px 0 8px;
    height: 22px;
    color: var(--text);
    font-size: var(--font-sm);
}

.tb-btn:hover {
    background-color: var(--bg-control-hover);
}

.tb-btn:disabled {
    opacity: 0.4;
}

/* ノーツ種別ボタン。左端の色帯でnote-spec.mdの色と対応づける(§2.2: 種別はツールバーへ) */
.tool-btn {
    border-left-width: 3px;
    min-width: 42px;
}

.tool-btn--selected {
    background-color: var(--accent);
    color: rgb(12, 12, 16);
    -unity-font-style: bold;
}

.tool-btn--tap { border-left-color: var(--note-tap); }
.tool-btn--extap { border-left-color: var(--note-extap); }
.tool-btn--slide { border-left-color: var(--note-slide); }
.tool-btn--flick { border-left-color: var(--note-flick); }
.tool-btn--neutral { border-left-color: var(--text-dim); }
.tool-btn--event { border-left-color: var(--event-bpm); }

.field-label {
    color: var(--text-dim);
    font-size: var(--font-sm);
    margin-right: 4px;
}

.status-text {
    color: var(--text-dim);
    font-size: var(--font-sm);
    margin-right: 8px;
}

.dirty-badge {
    font-size: var(--font-sm);
    -unity-font-style: bold;
    margin-right: 4px;
}

.dirty-badge--dirty { color: var(--note-extap); }
.dirty-badge--clean { color: var(--text-dim); }

/* ---------- B: メイン行 ---------- */

.main-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.tabs-host {
    flex-grow: 1;
    min-width: 0;
    background-color: var(--bg-canvas);
}

/* editor-ui-rework-r4.md §2: painter2Dの描画も絶対配置の子Labelも要素の矩形を越えると
   既定(overflow:visible)ではクリップされず、上のバンド類の上に重なって見えてしまう。 */
.notes-sheet,
.preview-surface {
    flex-grow: 1;
    overflow: hidden;
}

/* editor-ui-rework-r8.md §5.2: プレビュー画面左上のハイスピード表示。Painter2Dは文字を
   描けないため、他のラベル類(sheetLabels等)と同じく絶対配置のLabel要素として重ねる。 */
.hi-speed-label {
    position: absolute;
    left: 6px;
    top: 6px;
    color: rgb(230, 230, 230);
    background-color: rgba(0, 0, 0, 0.45);
    padding: 2px 6px;
    font-size: 12px;
}

/*
    参考画像の「⟨タイムライン⟩⟨譜面プレビュー⟩」タブ見出し。標準のTabViewは内部の
    content-containerが確実に伸びる保証をコードから検証できなかったため使わず、
    ボタン2つ + 中身VisualElementのdisplay切替で自前実装している(§2.3)。
*/
.tab-header {
    flex-direction: row;
    flex-shrink: 0;
    background-color: var(--bg-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    padding: 2px 2px 0 4px;
}

.tab-header-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px 1px 0 1px;
    border-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin: 0 2px 0 0;
    padding: 4px 12px 4px 12px;
    color: var(--text-dim);
    font-size: var(--font-sm);
}

.tab-header-btn:hover {
    color: var(--text);
}

.tab-header-btn--selected {
    background-color: var(--bg-canvas);
    border-color: var(--border);
    color: var(--text);
    -unity-font-style: bold;
}

/* タブ内のキャンバスは常に残り全域を埋める */
.canvas-host {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    background-color: var(--bg-canvas);
}

/* ---------- D: 右パネル(§2.5、editor-ui-rework-r11.md §4で再構成) ---------- */

.right-panel {
    width: 300px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: var(--bg-panel);
    border-left-width: 1px;
    border-left-color: var(--border);
}

/* タブ側(曲/表示/結果)は残り空間を埋め、インスペクタが下に固定で残る */
.right-tab-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.right-scroll {
    flex-grow: 1;
}

/* インスペクタは常設。選択内容で行数が大きく変わるため固定高にせず、
   上限だけ決めてはみ出した分は内部スクロールに任せる(r11 §4.3)。 */
.right-inspector {
    flex-shrink: 0;
    flex-direction: column;
    max-height: 45%;
    border-top-width: 1px;
    border-top-color: var(--border);
    background-color: var(--bg-panel);
}

.right-inspector .right-scroll {
    flex-grow: 1;
}

.subsection-heading {
    background-color: var(--bg-band);
    -unity-font-style: bold;
    font-size: var(--font-sm);
    padding: 3px 0 3px 6px;
    margin: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.subsection-heading--pinned {
    flex-shrink: 0;
}

/* 参考画像と同じ「ラベル左・値右」の2カラム(§2.5: 現状は縦積みで間延びしている) */
/* editor-ui-rework-r4.md §7 続報: heightを固定していると、ランタイム既定テーマの
   TextField系コントロール(内部padding込みの必要高さ)がこの20pxに収まりきらず、
   はみ出した分が次の行の不透明な背景に隠れて「文字が見えない」ように見えていた
   （ユーザーが指摘した「入力枠が被っている」崩れと同一原因）。min-heightにして
   コントロールの実際の必要高さぶん行が伸びるようにし、隠れを防ぐ。 */
.prop-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin: 1px 4px 1px 4px;
}

.prop-row > .prop-label {
    width: 88px;
    flex-shrink: 0;
    color: var(--text-dim);
    font-size: var(--font-sm);
}

.prop-row > .prop-value {
    flex-grow: 1;
    margin: 0;
    min-width: 0;
}

.prop-row .unity-base-field__input,
.status-bar .unity-base-field__input,
.toolbar .unity-base-field__input,
.modal .unity-base-field__input {
    background-color: var(--bg-control);
    border-color: var(--border);
    color: var(--text);
    --unity-cursor-color: var(--text);
    --unity-selection-color: rgba(74, 158, 255, 0.45);
}

/* editor-ui-rework-r4.md §7 続報: colorは継承プロパティなので、上のルールで
   .unity-base-field__input(コンテナ)へ当てても、既定のランタイムテーマが内部の
   実テキスト要素(.unity-text-element)へ直接colorを明示していれば継承値は負ける
   （継承は常に「その要素への明示指定」より優先度が低いため、上のルールの詳細度に関わらず
   上書きされる）。実テキスト要素へ直接当てて確実に上書きする。 */
.prop-row .unity-base-field__input .unity-text-element,
.status-bar .unity-base-field__input .unity-text-element,
.toolbar .unity-base-field__input .unity-text-element,
.modal .unity-base-field__input .unity-text-element {
    color: var(--text);
}

.prop-note {
    color: var(--text-dim);
    font-size: var(--font-sm);
    white-space: normal;
    margin: 2px 4px 2px 4px;
}

.stats-text {
    white-space: normal;
    font-size: var(--font-sm);
    margin: 4px;
}

.inspector-host {
    min-height: 60px;
}

/* painter2Dでは文字が描けないので、Ground/Sky見出しと小節番号だけLabelを重ねる */
.sheet-label {
    font-size: 10px;
    color: var(--text-dim);
}

/* イベントレーン(§7.3)のチップ。BPM/拍子/ソフランをクリックで選択・追加できるよう、
   文字だけでなくチップ全体をLabel要素にしてポインタイベントを受けられるようにしている。 */
.event-chip {
    font-size: 10px;
    padding: 1px 3px;
    border-radius: 3px;
    color: rgb(24, 24, 24);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.event-chip--bpm { background-color: var(--event-bpm); }
.event-chip--meter { background-color: var(--event-meter); }
.event-chip--scroll { background-color: var(--event-scroll); }

.event-chip--selected {
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.validation-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    white-space: normal;
    font-size: var(--font-sm);
    margin: 0;
    padding: 2px 4px 2px 4px;
}

.validation-item:hover { background-color: var(--bg-control-hover); }
.validation-item--error { color: rgb(255, 128, 128); }
.validation-item--warning { color: rgb(255, 217, 102); }
.validation-item--info { color: var(--text); }

/* ---------- C: ステータスバー(§2.6) ---------- */

.status-bar {
    min-height: var(--band-h);
    border-bottom-width: 0;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.transport-btn {
    min-width: 28px;
    -unity-text-align: middle-center;
}

.link-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-dim);
    font-size: var(--font-sm);
    margin: 0;
    padding: 0 6px 0 6px;
}

.link-btn:hover { color: var(--text); }

.status-bar .unity-base-popup-field {
    margin: 0 2px 0 2px;
    min-width: 96px;
}

/* editor-ui-rework-r5.md §7(b): バンドがmin-heightで伸びうる以上、スライダーの高さも
   明示して溝とつまみのずれを防ぐ。 */
.zoom-slider {
    width: 110px;
    height: 16px;
    margin: 0 4px 0 4px;
}

/* 曲全体のどこにいるかを常時見せる(§2.4「スクロールバーが無く把握できない」への対処) */
.status-scrub {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    min-width: 80px;
}

.status-scrub > .unity-slider {
    flex-grow: 1;
    height: 16px;
    margin: 0 8px 0 8px;
}

/* ---------- モーダル ---------- */

.overlay-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* editor-ui-rework-r11.md §2.3: IME変換中の文字列をキャレット位置に重ねて表示する。
   UITKのテキストに下線スタイルは無いためborder-bottomで代用する。 */
.ime-composition-overlay {
    position: absolute;
    background-color: var(--bg-overlay);
    color: var(--text);
    border-bottom-width: 1px;
    border-bottom-color: var(--accent);
    padding: 1px 3px;
    font-size: var(--font-sm);
}

.ime-debug-overlay {
    position: absolute;
    left: 4px;
    bottom: 4px;
    background-color: rgba(0, 0, 0, 0.7);
    color: var(--text);
    padding: 3px 6px;
    font-size: var(--font-sm);
}

.modal-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.modal {
    background-color: var(--bg-overlay);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
    padding: 8px;
    min-width: 420px;
}

/* editor-ui-rework-r5.md §2.1: 設定モーダルは中身のタブ数が多いので固定サイズにする。 */
.settings-modal {
    min-width: 560px;
    max-width: 560px;
    height: 460px;
}

.settings-body {
    flex-grow: 1;
    margin-top: 4px;
}

.settings-section-title {
    -unity-font-style: bold;
    color: var(--text-dim);
    font-size: var(--font-sm);
    margin: 8px 4px 2px 4px;
}

.modal-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.modal-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.browse-list {
    height: 300px;
    background-color: var(--bg-canvas);
    border-width: 1px;
    border-color: var(--border);
}

.browse-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 2px 6px 2px 6px;
    font-size: var(--font-sm);
    color: var(--text);
}

.browse-item:hover { background-color: var(--bg-control-hover); }
.browse-item--dir { color: var(--note-tap); }
